@@ -0,0 +1,35 @@
+from pathlib import Path
+from xml.etree import ElementTree as ET
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parent.parent
+RES = ROOT / 'app/src/main/res'
+CORE = ROOT / 'app/src/main/java/app/getknit/knit'
+for file in RES.rglob('*.xml'):
+    ET.parse(file)
+strings = {}
+for name in ('values', 'values-pt-rBR'):
+    root = ET.parse(RES/name/'strings.xml').getroot()
+    keys = [x.attrib['name'] for x in root if x.tag == 'string']
+    assert len(keys) == len(set(keys)), f'duplicate resource key in {name}'
+    strings[name] = set(keys)
+for code in ['nos_live_title','nos_live_open','nos_live_join','nos_live_connected','nos_tab_messages','nos_tab_radio']:
+    assert all(code in x for x in strings.values()), code
+assert 'CHANGE_WIFI_MULTICAST_STATE' in (ROOT/'app/src/main/AndroidManifest.xml').read_text()
+nav = (CORE/'ui/KnitApp.kt').read_text()
+assert 'LanRadioScreen(' in nav and 'Routes.RADIO_LAN_LIVE' in nav
+hub = (CORE/'ui/radiohub/RadioHubScreen.kt').read_text()
+assert 'nos_open_live_radio' in hub and 'onOpenLiveRadio' in hub
+chat = (CORE/'ui/chatlist/ChatListScreen.kt').read_text()
+assert 'nos_tab_messages' in chat and 'nos_tab_radio' in chat
+assert 'GroupPttScreen(' in nav and 'Routes.GROUP_PTT' in nav
+assert 'sendChat(' in (CORE/'ui/radiohub/GroupPttViewModel.kt').read_text()
+engine = (CORE/'ui/radiohub/LanRadioEngine.kt').read_text()
+for snippet in ('MulticastSocket(', 'AudioRecord(', 'AudioTrack(', 'LanRadioWire.Kind.AUDIO', 'DatagramPacket('):
+    assert snippet in engine, snippet
+img = Image.open(RES/'drawable-nodpi/nos_wordmark.png')
+assert img.mode == 'RGBA' and img.getchannel('A').getextrema() == (0,255)
+for scale in ('mdpi', 'hdpi', 'xhdpi', 'xxhdpi', 'xxxhdpi'):
+    for part in ('ic_launcher.png','ic_launcher_round.png','ic_launcher_foreground.png'):
+        assert (RES/f'mipmap-{scale}'/part).is_file()
+print('REV6 static verification: resources, navigation, audio path, original recordings and NÓS logo OK')
diff --git a/scripts/nos_rev6_wire_test.kt b/scripts/nos_rev6_wire_test.kt
new file mode 100644
index 0000000..6928bb4
--- /dev/null
+++ b/scripts/nos_rev6_wire_test.kt
@@ -0,0 +1,38 @@
+package app.getknit.knit.ui.radiohub
+
+fun main() {
+    var checks = 0
+    fun ok(value: Boolean, message: String) { check(value) { message }; checks++ }
+    val key = LanRadioWire.deriveKey("geral", "canal-secreto-123")
+    val same = LanRadioWire.deriveKey(" GERAL ", "canal-secreto-123")
+    val wrong = LanRadioWire.deriveKey("geral", "outra-senha-123")
+    val audio = ByteArray(LanRadioWire.PCM_BYTES) { (it * 11).toByte() }
+    val frame = LanRadioWire.Frame(LanRadioWire.Kind.AUDIO, 34L, 88L, 9, audio)
+    val encoded = LanRadioWire.encode(key, frame)!!
+    ok(encoded.size <= LanRadioWire.MAX_DATAGRAM, "packet over MTU")
+    ok(LanRadioWire.decode(key, encoded)?.audio?.contentEquals(audio) == true, "roundtrip pcm")
+    ok(LanRadioWire.decode(same, encoded)?.turn == 88L, "same channel normalization")
+    ok(LanRadioWire.decode(wrong, encoded) == null, "wrong key must fail")
+    encoded[encoded.lastIndex] = (encoded.last().toInt() xor 1).toByte()
+    ok(LanRadioWire.decode(key, encoded) == null, "tampering must fail")
+    ok(LanRadioWire.encode(key, frame.copy(audio = ByteArray(5))) == null, "reject broken audio")
+    val replay = LanRadioReplay()
+    ok(replay.accept(frame), "first packet")
+    ok(!replay.accept(frame), "replay rejected")
+    ok(!replay.accept(frame.copy(sequence = 8)), "late packet rejected")
+    ok(replay.accept(frame.copy(sequence = 10)), "next packet")
+    var clock = 1000L
+    val floor = LanRadioFloor { clock }
+    ok(floor.claim(20, 100), "first floor")
+    ok(!floor.claim(30, 200), "higher sender yields")
+    ok(floor.claim(10, 300), "lower sender wins contention")
+    ok(!floor.extend(20, 100), "previous sender cannot extend")
+    ok(floor.extend(10, 300), "holder extends")
+    floor.release(30, 200)
+    ok(floor.active()?.sender == 10L, "wrong release ignored")
+    clock += 1501L
+    ok(floor.active() == null, "lease expired")
+    ok(LanRadioWire.decode(key, byteArrayOf(1, 2, 3)) == null, "short packet rejected")
+    ok(!LanRadioWire.validCredentials("geral", "123"), "weak shared secret rejected")
+    println("NÓS REV6 local radio core: $checks/$checks checks OK")
+}

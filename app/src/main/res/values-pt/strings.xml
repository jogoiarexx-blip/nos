    <string name="onboarding_tagline">Converse com pessoas próximas — sem conta e sem precisar de internet.</string>
    <string name="onboarding_how_hop_title">De celular para celular</string>
    <string name="onboarding_how_hop_body">Os celulares próximos se conectam por Wi-Fi e Bluetooth. As mensagens podem passar de um aparelho para outro, sem rede central.</string>
